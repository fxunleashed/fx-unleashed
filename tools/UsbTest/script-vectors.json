{
  "_note": "Shared by the library's checker (tools/script_rules.mjs) and the plugin's (Usb/ScriptCheck.cs, copied to tools/UsbTest/script-vectors.json). Each source is the text after \"js:\". Keep both copies identical. See SCRIPTS.md.",
  "allow": [
    { "name": "the LIFT latch of the converted LMU dashes", "source": "// Variable initialisieren, falls noch nicht geschehen\nif (root.valTriggered == null) {\n    root.valTriggered = false;\n}\n\n// Wenn der Wert > 240 ist, Trigger auf true setzen\nif ($prop('GameRawData.PlayerNativeTelemetry.mLiftAndCoastProgress') > 240) {\n    root.valTriggered = true;\n}\n\n// Reset bei Bremse\nif ($prop('Brake') > 5) { root.valTriggered = false; }\n\nreturn root.valTriggered;" },
    { "name": "a plain return", "source": "return 1;" },
    { "name": "arithmetic, comparison, logic and a conditional", "source": "var x = $prop('SpeedKmh') * 3.6; if (x > 100 && root.fast != true) { root.fast = true; } else { root.fast = false; } return root.fast ? 1 : 0;" },
    { "name": "Math helpers", "source": "return Math.max(0, Math.min(100, $prop('Fuel') * 2));" },
    { "name": "$prop with a fallback", "source": "return $prop('Brake', 0);" },
    { "name": "use strict", "source": "\"use strict\"; return 1;" },
    { "name": "nullish coalescing", "source": "return root.a ?? 0;" },
    { "name": "not", "source": "return !root.flag;" },
    { "name": "compound assignment on root", "source": "root.count += 1; return root.count;" },
    { "name": "let and const", "source": "const a = 2; let b = a + 1; b -= 1; return b;" },
    { "name": "comments and text joins", "source": "// hello\nreturn 'a' + 'b';" }
  ],
  "refuse": [
    { "name": "eval", "source": "return eval('1+1');" },
    { "name": "the Function constructor", "source": "return new Function('return 1')();" },
    { "name": "constructor chain", "source": "return root.constructor.constructor('return 1')();" },
    { "name": "__proto__", "source": "root.__proto__ = {}; return 1;" },
    { "name": "computed member", "source": "return root['constructor'];" },
    { "name": "globalThis", "source": "return globalThis;" },
    { "name": "window", "source": "return window;" },
    { "name": "this", "source": "return this;" },
    { "name": "for loop", "source": "for (;;) {} return 1;" },
    { "name": "while loop", "source": "while (true) {} return 1;" },
    { "name": "function expression", "source": "var f = function () { return 1; }; return 1;" },
    { "name": "arrow function", "source": "return (() => 1)();" },
    { "name": "new", "source": "return new Date();" },
    { "name": "$prop name built from text", "source": "return $prop('A' + 'B');" },
    { "name": "$prop name from a variable", "source": "var n = 'Speed'; return $prop(n);" },
    { "name": "array literal", "source": "return [1, 2, 3];" },
    { "name": "object literal", "source": "return { a: 1 };" },
    { "name": "template literal", "source": "return `x${1}`;" },
    { "name": "regular expression", "source": "return /a/.test('a');" },
    { "name": "another function", "source": "return parseInt('1');" },
    { "name": "delete", "source": "delete root.a; return 1;" },
    { "name": "typeof", "source": "return typeof root.a;" },
    { "name": "increment", "source": "root.i++; return 1;" },
    { "name": "try and catch", "source": "try { return 1; } catch (e) { return 2; }" },
    { "name": "a syntax error", "source": "if (" },
    { "name": "a method call on root", "source": "return root.toString();" },
    { "name": "assigning to $prop", "source": "$prop = 1; return 1;" },
    { "name": "dynamic import", "source": "return import('x');" },
    { "name": "optional chaining", "source": "return root?.a;" },
    { "name": "comma operator", "source": "return (1, 2);" },
    { "name": "Math.random", "source": "return Math.random();" },
    { "name": "exponent", "source": "return 2 ** 3;" },
    { "name": "in", "source": "return 'a' in root;" },
    { "name": "Math as a value", "source": "var m = Math; return 1;" },
    { "name": "$prop as a value", "source": "var p = $prop; return 1;" },
    { "name": "a label and break", "source": "a: while (1) { break a; } return 1;" },
    { "name": "redeclaring root", "source": "var root = 1; return root;" },
    { "name": "a variable called constructor", "source": "let constructor = 1; return 1;" },
    { "name": "a getter on the global object", "source": "return Object.keys(root);" },
    { "name": "a call through a variable", "source": "var f = 1; return f();" },
    { "name": "a BigInt", "source": "return 10n;" }
  ]
}
