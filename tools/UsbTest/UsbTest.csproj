<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline checks for USB mode (docs/usb-mode.md, "Checking without the wheel"): compiles all of the plugin's sources
       against SimHub's DLLs and draws what the wheel would get. Needs SimHub installed; nothing is sent to the wheel.
       Build with "dotnet build -c Release", then run bin\Release\net48\UsbTest.exe OUTDIR [saver | atsr | ui]
         no mode: dash layout checks, USB budget, light presets, JSON round trip (PNG snapshots in OUTDIR)
         saver:   the logo screensaver
         atsr:    ATSR-Hub layer stacking and LED maps
         ui:      the settings section, rendered offscreen to PNG -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x86</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SimHubPath Condition="'$(SIMHUB_INSTALL_PATH)' != ''">$(SIMHUB_INSTALL_PATH)</SimHubPath>
    <SimHubPath Condition="'$(SimHubPath)' == ''">C:\Program Files (x86)\SimHub\</SimHubPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <None Include="golden-fxpro.txt" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\..\*.cs" />
    <Compile Include="..\..\Usb\*.cs" />
    <Compile Include="..\..\Ui\*.cs" />
    <EmbeddedResource Include="..\..\assets\logo-nobg.png" LogicalName="User.FXProRpmSync.logo-nobg.png" />
    <EmbeddedResource Include="..\..\assets\fxpro-outline.svg" LogicalName="User.FXProRpmSync.fxpro-outline.svg" />
    <EmbeddedResource Include="..\..\assets\gtneo-outline.svg" LogicalName="User.FXProRpmSync.gtneo-outline.svg" />
    <EmbeddedResource Include="..\..\docs\legal\*.md" LogicalName="User.FXProRpmSync.Legal.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\Resources\screen-images.json" LogicalName="User.FXProRpmSync.screen-images.json" />
    <Reference Include="GameReaderCommon"><HintPath>$(SimHubPath)GameReaderCommon.dll</HintPath></Reference>
    <Reference Include="SimHub.Plugins"><HintPath>$(SimHubPath)SimHub.Plugins.dll</HintPath></Reference>
    <Reference Include="SimHub.Logging"><HintPath>$(SimHubPath)SimHub.Logging.dll</HintPath></Reference>
    <Reference Include="log4net"><HintPath>$(SimHubPath)log4net.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(SimHubPath)Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="BA63Driver"><HintPath>$(SimHubPath)BA63Driver.dll</HintPath></Reference>
    <Reference Include="SerialDash"><HintPath>$(SimHubPath)SerialDash.dll</HintPath></Reference>
    <Reference Include="NCalc"><HintPath>$(SimHubPath)NCalc.dll</HintPath></Reference>
    <Reference Include="Antlr3.Runtime"><HintPath>$(SimHubPath)Antlr3.Runtime.dll</HintPath></Reference>
    <Reference Include="Jint"><HintPath>$(SimHubPath)Jint.dll</HintPath></Reference>
    <Reference Include="Acornima"><HintPath>$(SimHubPath)Acornima.dll</HintPath></Reference>
    <Reference Include="System.Memory"><HintPath>$(SimHubPath)System.Memory.dll</HintPath></Reference>
    <Reference Include="System.Buffers"><HintPath>$(SimHubPath)System.Buffers.dll</HintPath></Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe"><HintPath>$(SimHubPath)System.Runtime.CompilerServices.Unsafe.dll</HintPath></Reference>
    <Reference Include="System.Numerics.Vectors"><HintPath>$(SimHubPath)System.Numerics.Vectors.dll</HintPath></Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
