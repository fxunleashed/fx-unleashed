<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>User.FXProRpmSync</AssemblyName>
    <RootNamespace>User.FXProRpmSync</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.7.3</Version>
    <Product>FX Unleashed</Product>
    <Authors>ziadkadry99</Authors>
    <Copyright>Copyright (c) 2026 ziadkadry99. GPL-3.0-or-later.</Copyright>
    <SimHubPath Condition="'$(SIMHUB_INSTALL_PATH)' != ''">$(SIMHUB_INSTALL_PATH)</SimHubPath>
    <SimHubPath Condition="'$(SimHubPath)' == ''">C:\Program Files (x86)\SimHub\</SimHubPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="GameReaderCommon"><HintPath>$(SimHubPath)GameReaderCommon.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SimHub.Plugins"><HintPath>$(SimHubPath)SimHub.Plugins.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SimHub.Logging"><HintPath>$(SimHubPath)SimHub.Logging.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="log4net"><HintPath>$(SimHubPath)log4net.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(SimHubPath)Newtonsoft.Json.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="BA63Driver"><HintPath>$(SimHubPath)BA63Driver.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SerialDash"><HintPath>$(SimHubPath)SerialDash.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="NCalc"><HintPath>$(SimHubPath)NCalc.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Jint"><HintPath>$(SimHubPath)Jint.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Acornima"><HintPath>$(SimHubPath)Acornima.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\menu-icon.png" LogicalName="User.FXProRpmSync.menu-icon.png" />
    <EmbeddedResource Include="assets\logo-nobg.png" LogicalName="User.FXProRpmSync.logo-nobg.png" />
    <EmbeddedResource Include="assets\fxpro-outline.svg" LogicalName="User.FXProRpmSync.fxpro-outline.svg" />
    <EmbeddedResource Include="assets\gtneo-outline.svg" LogicalName="User.FXProRpmSync.gtneo-outline.svg" />
    <EmbeddedResource Include="assets\fx-outline.svg" LogicalName="User.FXProRpmSync.fx-outline.svg" />
    <EmbeddedResource Include="assets\logo.png" LogicalName="User.FXProRpmSync.logo.png" />
    <EmbeddedResource Include="Usb\Designer\*.*" LogicalName="User.FXProRpmSync.Designer.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Usb\Bundled\*.json" LogicalName="User.FXProRpmSync.Bundled.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Usb\BuiltIn\*.json" LogicalName="User.FXProRpmSync.BuiltIn.%(Filename)%(Extension)" />
    <EmbeddedResource Include="docs\legal\*.md" LogicalName="User.FXProRpmSync.Legal.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\screen-images.json" LogicalName="User.FXProRpmSync.screen-images.json" />
  </ItemGroup>

  <!-- simgame.exe (SimGameStub/) is built first and embedded; the plugin extracts it at runtime (see SimGameFeed). -->
  <ItemGroup>
    <Compile Remove="SimGameStub\**" />
    <!-- tools/: offline test programs and scripts (docs/usb-mode.md), not part of the plugin -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <None Remove="SimGameStub\**" />
  </ItemGroup>
  <Target Name="BuildSimGameStub" BeforeTargets="BeforeBuild">
    <MSBuild Projects="SimGameStub\SimGameStub.csproj" Targets="Restore" Properties="Configuration=$(Configuration);StubRestore=1" />
    <MSBuild Projects="SimGameStub\SimGameStub.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <EmbeddedResource Include="SimGameStub\bin\$(Configuration)\net48\simgame.exe" LogicalName="User.FXProRpmSync.simgame.exe" />
    </ItemGroup>
  </Target>

  <!-- Copy into SimHub (SimHub must be closed). Set -p:DeployToSimHub=false to skip. -->
  <Target Name="DeployToSimHub" AfterTargets="Build" Condition="'$(DeployToSimHub)' != 'false'">
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll;$(TargetDir)$(TargetName).pdb" DestinationFolder="$(SimHubPath)" ContinueOnError="true" />
  </Target>

</Project>
